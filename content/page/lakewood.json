 data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-1ad8afe elementor-widget elementor-widget-heading\" data-id=\"1ad8afe\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Ratings for<br>\nThe Drake Law Firm, PC</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-5f27886 elementor-widget elementor-widget-spacer\" data-id=\"5f27886\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"></div>\n\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a2263d5 elementor-widget elementor-widget-text-editor\" data-id=\"a2263d5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><strong><a href=\"https://www.google.com/search?sca_esv=e4e3b1ba951674fc&amp;rlz=1C5GCCM_en&amp;biw=1344&amp;bih=723&amp;si=AMgyJEtREmoPL4P1I5IDCfuA8gybfVI2d5Uj7QMwYCZHKDZ-E0EJ_QH59b-wuzWoZcMrlIJRWEt3StNqFLIWgUze0K-6CgvB2g5k3Od2FucjvZw49TDHtO6u1PpHyzeENYsl_sOk4SyOs4I8fQmXXfSxmsfz06rwOQ%3D%3D&amp;q=The+Drake+Law+Firm,+PC+Reviews&amp;sa=X&amp;ved=2ahUKEwjAhbbKxrWQAxUEmGoFHT4cCn0Q0bkNegQIJRAE&amp;cshid=1761058620091811\">Read Client Reviews</a></strong></p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-f81d491\" data-eae-slider=\"14961\" data-id=\"f81d491\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-ccc16b6 elementor-widget elementor-widget-google_maps\" data-id=\"ccc16b6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"google_maps.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-custom-embed\">\n\t\t\t<iframe loading=\"lazy\"\n\t\t\t\t\tsrc=\"https://maps.google.com/maps?q=The%20Drake%20Law%20Firm%20Lakewood&#038;t=m&#038;z=10&#038;output=embed&#038;iwloc=near\"\n\t\t\t\t\ttitle=\"The Drake Law Firm Lakewood\"\n\t\t\t\t\taria-label=\"The Drake Law Firm Lakewood\"\n\t\t\t></iframe>\n\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-ab3007a elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"25529\" data-id=\"ab3007a\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-c3f7415\" data-eae-slider=\"85315\" data-id=\"c3f7415\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-988dc3e elementor-widget elementor-widget-heading\" data-id=\"988dc3e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">About The Drake Law Firm, PC\n</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-956f290 elementor-widget elementor-widget-text-editor\" data-id=\"956f290\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>The <a href=\"https://thedrakelawfirm.com/\">Drake Law Firm, PC</a> serves Lakewood and the surrounding Jefferson County communities with dedicated family law representation. Our <a href=\"https://thedrakelawfirm.com/colorado/locations/\"><span data-sheets-root=\"1\">additional office locations</span></a>&nbsp;in Colorado are strategically positioned to provide convenient access to clients throughout Jefferson County and the greater Denver metro area. Our practice is built on understanding that family legal matters require both professional knowledge and genuine compassion—we bring that balance to every client relationship.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-14af4a7 elementor-align-center elementor-widget elementor-widget-button\" data-id=\"14af4a7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm elementor-animation-grow\" href=\"https://thedrakelawfirm.com/contact-us/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Talk to a Lakewood Family Attorney Today</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1733df8 elementor-widget elementor-widget-heading\" data-id=\"1733df8\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">The Difference Family Law Focus Makes\n</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-c1e36bd elementor-widget elementor-widget-text-editor\" data-id=\"c1e36bd\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Family law is all we do, which means our Lakewood attorneys have developed deep knowledge of Colorado&#8217;s specific requirements, procedures, and court systems. From complex property division involving retirement accounts and business interests to challenging custody disputes, our focused practice allows us to handle your case with the skill and attention it deserves. We know what strategies work in Jefferson County courts because we&#8217;ve devoted our careers to mastering this area of law.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1159be1 elementor-widget elementor-widget-heading\" data-id=\"1159be1\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Your Partner Through Life's Transitions</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2c3d46a elementor-widget elementor-widget-text-editor\" data-id=\"2c3d46a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Our <a href=\"https://thedrakelawfirm.com/colorado/attorneys/\"><span data-sheets-root=\"1\">divorce attorneys in Lakewood</span></a> bring substantial family law experience to each case we accept. We handle the full spectrum of family legal matters: divorce and legal separation, child custody and parenting time, child support and spousal maintenance, property and debt division, modifications of existing orders, and enforcement when agreements aren&#8217;t being honored.</p><p>We recognize that every family&#8217;s situation is unique. The approach that&#8217;s right for one client may not serve another&#8217;s best interests, which is why we invest time in understanding your specific circumstances, priorities, and goals before charting a course forward.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-4a5c30f elementor-widget elementor-widget-heading\" data-id=\"4a5c30f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">A Team Committed to Your Success\n</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-49bcbbb elementor-widget elementor-widget-text-editor\" data-id=\"49bcbbb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>The Drake Law Firm&#8217;s Lakewood office includes experienced attorneys who understand both negotiation and litigation. We&#8217;re skilled at reaching favorable settlements when possible, but we&#8217;re fully prepared to advocate for you in court when necessary. Our years of practice in Jefferson County have given us insight into local court procedures, judicial tendencies, and effective case strategies. </p><p>We&#8217;ve also built professional relationships throughout the Lakewood legal community with mediators, parenting experts, financial professionals, and other specialists who often contribute to family law cases—connections that benefit our clients.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-11409d2 elementor-widget elementor-widget-heading\" data-id=\"11409d2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Compassionate Advocacy for Lakewood Families\n</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-4ddac16 elementor-widget elementor-widget-text-editor\" data-id=\"4ddac16\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>We understand that family law matters often arise during some of the most emotionally difficult times in people&#8217;s lives. Our Lakewood team approaches each case with both professional skill and genuine empathy. We&#8217;re here to provide steady guidance, protect your rights, and help you navigate this challenging period with confidence.</p><p>You deserve an attorney who listens, who understands what&#8217;s at stake, and who fights for outcomes that serve your best interests and your family&#8217;s future.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-38bb993 elementor-widget elementor-widget-heading\" data-id=\"38bb993\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Our Promise to You</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1694c9e elementor-widget elementor-widget-text-editor\" data-id=\"1694c9e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>When you choose The Drake Law Firm, you&#8217;re working with attorneys who take both legal excellence and ethical practice seriously. We stay current on changes in Colorado family law, maintain absolute confidentiality, and provide honest, realistic assessments of your case—even when that means having difficult conversations about challenges or risks.</p><p>You deserve an attorney who listens, who understands what&#8217;s at stake, and who fights for outcomes that serve your best interests and your family&#8217;s future.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b22a87d elementor-widget elementor-widget-heading\" data-id=\"b22a87d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Take the First Step</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f1c972b elementor-widget elementor-widget-text-editor\" data-id=\"f1c972b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Contact our Lakewood office to<a href=\"https://thedrakelawfirm.com/contact-us/\"> schedule a consultation</a>. We&#8217;ll listen to your story, answer your questions, and explain how we can help you move forward. Whether you&#8217;re considering divorce, facing a custody matter, or dealing with another family law issue, we&#8217;re here to provide the professional, compassionate representation you need.</p><p>You deserve an attorney who listens, who understands what&#8217;s at stake, and who fights for outcomes that serve your best interests and your family&#8217;s future.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-inner-section elementor-element elementor-element-10997b1 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"40845\" data-id=\"10997b1\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-791a97b\" data-eae-slider=\"3418\" data-id=\"791a97b\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-d22af16 elementor-widget elementor-widget-heading\" data-id=\"d22af16\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Directions to Our Lakewood Office\n</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<div class=\"elementor-element elementor-element-5ad07ad elementor-widget elementor-widget-text-editor\" data-id=\"5ad07ad\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Our office is conveniently located along the Colfax Avenue corridor. We are easily accessible from Edgewater, Arvada, Morrison, and throughout Jefferson County. <a href=\"https://www.google.com/maps/dir//The+Drake+Law+Firm,+PC,+12600+W+Colfax+Ave+Ste.+B-400,+Lakewood,+CO+80215/\">Click here for directions using Google Maps.</a></p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9bc61cb elementor-widget elementor-widget-text-editor\" data-id=\"9bc61cb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><b>Where to Park</b></p><p><span style=\"font-weight: 400;\">Parking is available in the lot adjacent to our building. Visitors can use the designated parking spaces near the entrance for convenient access to Suite B-400.</span></p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b1f5a12 elementor-widget elementor-widget-heading\" data-id=\"b1f5a12\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">How to Get to Our Lakewood Office:</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a52a506 elementor-widget elementor-widget-text-editor\" data-id=\"a52a506\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><strong>Coming from Edgewater</strong></p><ol><li>Head east on W 25th Ave and turn left onto Ingalls St.</li><li>Turn left onto W 26th Ave and continue for approximately 2.4 miles.</li><li>Turn left onto Kipling St and follow for about a mile.</li><li>Turn right onto W Colfax Ave and continue for 1.6 miles.</li><li>Turn left, then turn right.</li><li>The office will be on the left at 12600 W Colfax Ave, Suite B-400.</li></ol><div> </div><div><strong>Coming from Arvada</strong></div><ol><li>Head east on Ammons St and turn right onto Ralston Rd N.</li><li>Continue onto W 58th Ave, passing by Starbucks.</li><li>Use the left two lanes to turn left onto Kipling Pkwy.</li><li>Continue onto Kipling St and turn right to merge onto I-70 W.</li><li>Stay on I-70 W for approximately 4 miles.</li><li>Take exit 263 toward Denver West Colorado Mills Pkwy.</li><li>Turn left onto Denver West Colorado Mills Pkwy.</li><li>Use the left two lanes to turn left onto I-70BL/W Colfax Ave and continue for about 0.9 miles.</li><li>Turn right, then turn right again.</li><li>The office will be on the left at 12600 W Colfax Ave, Suite B-400.</li></ol><div> </div><div><strong>Coming from Morrison</strong></div><div> </div><ol><li>Head northeast and turn right onto CO-8 E/Bear Creek Ave/Morrison Rd.</li><li>Slight left to merge onto CO-470 W and continue for over 3 miles.</li><li>Use the right two lanes to take exit 1 to merge onto I-70 E toward Denver.</li><li>Stay on I-70 E for approximately 2.8 miles.</li><li>Take exit 263 toward Denver/Colorado Mills Parkway.</li><li>Slight right to merge onto Denver West Colorado Mills Pkwy.</li><li>Use the left two lanes to turn left onto I-70BL/W Colfax Ave and follow for 0.9 miles.</li><li>Turn right, then turn right again.</li><li>The office will be on the left at 12600 W Colfax Ave, Suite B-400.</li></ol>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-8ebec79 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"3791\" data-id=\"8ebec79\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-b46b88d\" data-eae-slider=\"83048\" data-id=\"b46b88d\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-117fac6 elementor-widget elementor-widget-heading\" data-id=\"117fac6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Lakewood Family Law Attorney FAQs</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8378f84 elementor-widget elementor-widget-accordion\" data-id=\"8378f84\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"accordion.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-accordion\">\n\t\t\t\t\t\t\t<div class=\"elementor-accordion-item\">\n\t\t\t\t\t<h3 id=\"elementor-tab-title-1371\" class=\"elementor-tab-title\" data-tab=\"1\" role=\"button\" aria-controls=\"elementor-tab-content-1371\" aria-expanded=\"false\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon elementor-accordion-icon-left\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"></i></span>\n\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"></i></span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" tabindex=\"0\">What does a Lakewood family law attorney do?</a>\n\t\t\t\t\t</h3>\n\t\t\t\t\t<div id=\"elementor-tab-content-1371\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"1\" role=\"region\" aria-labelledby=\"elementor-tab-title-1371\"><p><span style=\"font-weight: 400;\">A Lakewood family law attorney helps clients resolve legal matters that affect their families, such as divorce, custody, parenting plans, child support, and property division. At The Drake Law Firm, we work closely with Lakewood clients to understand their goals and take practical steps that protect their future. Whether you’re filing for divorce or modifying custody, a family lawyer helps you understand your rights, complete paperwork, and reach workable agreements.</span></p></div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"elementor-accordion-item\">\n\t\t\t\t\t<h3 id=\"elementor-tab-title-1372\" class=\"elementor-tab-title\" data-tab=\"2\" role=\"button\" aria-controls=\"elementor-tab-content-1372\" aria-expanded=\"false\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon elementor-accordion-icon-left\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"></i></span>\n\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"></i></span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" tabindex=\"0\">Do I have to go to court for a family law case in Lakewood?</a>\n\t\t\t\t\t</h3>\n\t\t\t\t\t<div id=\"elementor-tab-content-1372\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"2\" role=\"region\" aria-labelledby=\"elementor-tab-title-1372\"><p><span style=\"font-weight: 400;\">No, not every family law case in Lakewood has to go to court in person, although most new cases require a virtual court appearance called an Initial Status Conference. Many issues, like child custody,  support, or separation terms—can be settled through negotiation or mediation. If both parties are willing to cooperate, your Lakewood family lawyer can help draft legally binding agreements without having to visit a courtroom. But if cooperation breaks down, your attorney is prepared to represent you at hearings to resolve the remaining disputes.</span></p></div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"elementor-accordion-item\">\n\t\t\t\t\t<h3 id=\"elementor-tab-title-1373\" class=\"elementor-tab-title\" data-tab=\"3\" role=\"button\" aria-controls=\"elementor-tab-content-1373\" aria-expanded=\"false\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon elementor-accordion-icon-left\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"></i></span>\n\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"></i></span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" tabindex=\"0\">How long does it take to get divorced in Colorado?</a>\n\t\t\t\t\t</h3>\n\t\t\t\t\t<div id=\"elementor-tab-content-1373\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"3\" role=\"region\" aria-labelledby=\"elementor-tab-title-1373\"><p><span style=\"font-weight: 400;\">Colorado has a mandatory 91-day waiting period before a divorce can be finalized. This clock starts once your spouse has been served, or immediately if you filed together. After that, the timeline depends on how quickly you and your spouse agree on key issues like custody, support, and property division</span><b>.</b><span style=\"font-weight: 400;\"> A Lakewood family lawyer can help move things forward efficiently and make sure everything is handled correctly from the start.</span></p></div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"elementor-accordion-item\">\n\t\t\t\t\t<h3 id=\"elementor-tab-title-1374\" class=\"elementor-tab-title\" data-tab=\"4\" role=\"button\" aria-controls=\"elementor-tab-content-1374\" aria-expanded=\"false\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon elementor-accordion-icon-left\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"></i></span>\n\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"></i></span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" tabindex=\"0\">What happens if we already agree on everything?</a>\n\t\t\t\t\t</h3>\n\t\t\t\t\t<div id=\"elementor-tab-content-1374\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"4\" role=\"region\" aria-labelledby=\"elementor-tab-title-1374\"><p><span style=\"font-weight: 400;\">If both spouses agree on all terms, like parenting time, asset division, and support—you can submit your documents and your settlement for the court to approve.  This is called an uncontested divorce. Uncontested divorces are usually faster and more affordable than a fight. Your Lakewood CO family law attorney will still review your mandatory financial disclosures, your parenting plan, and the agreement on assets and debts to protect your interests, make sure everything complies with Colorado law, and file the necessary documents so the court can finalize the divorce without delay.</span></p></div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"elementor-accordion-item\">\n\t\t\t\t\t<h3 id=\"elementor-tab-title-1375\" class=\"elementor-tab-title\" data-tab=\"5\" role=\"button\" aria-controls=\"elementor-tab-content-1375\" aria-expanded=\"false\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon elementor-accordion-icon-left\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-closed\"><i class=\"fas fa-plus\"></i></span>\n\t\t\t\t\t\t\t\t<span class=\"elementor-accordion-icon-opened\"><i class=\"fas fa-minus\"></i></span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-accordion-title\" tabindex=\"0\">Can I change my custody or support order later?</a>\n\t\t\t\t\t</h3>\n\t\t\t\t\t<div id=\"elementor-tab-content-1375\" class=\"elementor-tab-content elementor-clearfix\" data-tab=\"5\" role=\"region\" aria-labelledby=\"elementor-tab-title-1375\"><p><span style=\"font-weight: 400;\">Yes, custody and child support orders can be modified if your circumstances change. This might include a job loss, relocation, changes in parenting time, or shifts in a child’s needs. To request a change, you must show that the new situation is significant and affects the original order. A Lakewood family lawyer can help you prepare the request, file it with the court, and advocate for terms that reflect your current reality.</span></p></div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<script type=\"application/ld+json\">{\"@context\":\"https:\\/\\/schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What does a Lakewood family law attorney do?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"<p><span style=\\\"font-weight: 400;\\\">A Lakewood family law attorney helps clients resolve legal matters that affect their families, such as divorce, custody, parenting plans, child support, and property division. At The Drake Law Firm, we work closely with Lakewood clients to understand their goals and take practical steps that protect their future. Whether you\\u2019re filing for divorce or modifying custody, a family lawyer helps you understand your rights, complete paperwork, and reach workable agreements.<\\/span><\\/p>\"}},{\"@type\":\"Question\",\"name\":\"Do I have to go to court for a family law case in Lakewood?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"<p><span style=\\\"font-weight: 400;\\\">No, not every family law case in Lakewood has to go to court in person, although most new cases require a virtual court appearance called an Initial Status Conference. Many issues, like child custody,\\u00a0 support, or separation terms\\u2014can be settled through negotiation or mediation. If both parties are willing to cooperate, your Lakewood family lawyer can help draft legally binding agreements without having to visit a courtroom. But if cooperation breaks down, your attorney is prepared to represent you at hearings to resolve the remaining disputes.<\\/span><\\/p>\"}},{\"@type\":\"Question\",\"name\":\"How long does it take to get divorced in Colorado?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"<p><span style=\\\"font-weight: 400;\\\">Colorado has a mandatory 91-day waiting period before a divorce can be finalized. This clock starts once your spouse has been served, or immediately if you filed together. After that, the timeline depends on how quickly you and your spouse agree on key issues like custody, support, and property division<\\/span><b>.<\\/b><span style=\\\"font-weight: 400;\\\"> A Lakewood family lawyer can help move things forward efficiently and make sure everything is handled correctly from the start.<\\/span><\\/p>\"}},{\"@type\":\"Question\",\"name\":\"What happens if we already agree on everything?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"<p><span style=\\\"font-weight: 400;\\\">If both spouses agree on all terms, like parenting time, asset division, and support\\u2014you can submit your documents and your settlement for the court to approve.\\u00a0 This is called an uncontested divorce. Uncontested divorces are usually faster and more affordable than a fight. Your Lakewood CO family law attorney will still review your mandatory financial disclosures, your parenting plan, and the agreement on assets and debts to protect your interests, make sure everything complies with Colorado law, and file the necessary documents so the court can finalize the divorce without delay.<\\/span><\\/p>\"}},{\"@type\":\"Question\",\"name\":\"Can I change my custody or support order later?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"<p><span style=\\\"font-weight: 400;\\\">Yes, custody and child support orders can be modified if your circumstances change. This might include a job loss, relocation, changes in parenting time, or shifts in a child\\u2019s needs. To request a change, you must show that the new situation is significant and affects the original order. A Lakewood family lawyer can help you prepare the request, file it with the court, and advocate for terms that reflect your current reality.<\\/span><\\/p>\"}}]}</script>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-3c08914 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"72748\" data-id=\"3c08914\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-7e23648\" data-eae-slider=\"13965\" data-id=\"7e23648\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-a5f8c77 elementor-widget elementor-widget-html\" data-id=\"a5f8c77\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"LegalService\",\n  \"name\": \"The Drake Law Firm, PC\",\n  \"description\": \"Dedicated Colorado family law firm serving Lakewood, Jefferson County, and the greater Denver metro area. providing services in divorce, child custody, child support, spousal maintenance, property division, and related family law matters.\",\n  \"url\": \"https://thedrakelawfirm.com/colorado/locations/lakewood/\",\n  \"hasMap\": \"https://www.google.com/maps?cid=15466032453891293721\",\n  \"telephone\": \"+13039516427\",\n  \"image\": \"https://thedrakelawfirm.com/wp-content/uploads/2021/10/logo_drake_law.png\",\n  \"priceRange\": \"$$\",\n  \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"streetAddress\": \"12600 W Colfax Ave, Suite B-400\",\n    \"addressLocality\": \"Lakewood\",\n    \"addressRegion\": \"CO\",\n    \"postalCode\": \"80215\",\n    \"addressCountry\": \"US\"\n  },\n  \"geo\": {\n    \"@type\": \"GeoCoordinates\",\n    \"latitude\": 39.7391354,\n    \"longitude\": -105.1403264\n  },\n  \"openingHoursSpecification\": {\n    \"@type\": \"OpeningHoursSpecification\",\n    \"dayOfWeek\": [\n      \"Monday\",\n      \"Tu