    "rendered": "\t\t<div data-elementor-type=\"wp-page\" data-elementor-id=\"7892\" class=\"elementor elementor-7892\" data-elementor-post-type=\"page\">\n\t\t\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-3edc520 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"49066\" data-id=\"3edc520\" data-element_type=\"section\" data-e-type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t\t<div class=\"elementor-background-overlay\"></div>\n\t\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-5876ebb\" data-eae-slider=\"67732\" data-id=\"5876ebb\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-23b4431 elementor-widget elementor-widget-heading\" data-id=\"23b4431\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h1 class=\"elementor-heading-title elementor-size-default\">Frequently Asked Questions About Family Law</h1>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-700eaad elementor-align-center elementor-widget elementor-widget-button\" data-id=\"700eaad\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https://thedrakelawfirm.com/contact-us/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">Contact Us For Consultation</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t<section class=\"has_eae_slider elementor-section elementor-top-section elementor-element elementor-element-ed5fe87 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-eae-slider=\"96144\" data-id=\"ed5fe87\" data-element_type=\"section\" data-e-type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"has_eae_slider elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-05d21bd\" data-eae-slider=\"80963\" data-id=\"05d21bd\" data-element_type=\"column\" data-e-type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-4880552 elementor-widget elementor-widget-html\" data-id=\"4880552\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n \n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <style>\n    body {\n      background: #f5f7fa;\n      font-family: 'Segoe UI', Arial, sans-serif;\n      margin: 0;\n      padding: 0;\n    }\n    h2 {\n      text-align: center;\n      margin: 40px 0 28px 0;\n      font-size: 2.1rem;\n      color: #2c3e50;\n      letter-spacing: 1px;\n    }\n    .video-grid {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 48px;\n      max-width: 1680px;\n      margin: 0 auto;\n      padding: 24px 32px 72px 32px;\n    }\n    .video-card {\n      background: #fff;\n      border-radius: 7px;\n      box-shadow: 0 6px 28px rgba(44,62,80,0.10), 0 1.5px 5px rgba(44,62,80,0.03);\n      padding: 18px 24px 18px 24px;\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      transition: transform .15s, box-shadow .15s;\n      cursor: pointer;\n      position: relative;\n;\n    }\n    .video-card:hover {\n      transform: translateY(-6px) scale(1.025);\n      box-shadow: 0 10px 36px rgba(44,62,80,0.14), 0 4px 12px rgba(44,62,80,0.05);\n      z-index: 2;\n    }\n \n\n    .video-thumb {\n      width: 100%;\n      border-radius: 7px;\n      margin-bottom: 18px;\n      box-shadow: 0 2px 8px rgba(30,30,50,.09);\n      transition: box-shadow .18s;\n      height: 210px;             /* Thumbnail sada veći */\n      object-fit: cover;\n      object-position: center;\n      display: block;\n      background: #e3e3e3;\n    }\n    .video-card:hover .video-thumb {\n      box-shadow: 0 6px 24px rgba(41,128,185,0.11);\n    }\n    .video-title {\n      font-size: 1.12rem;\n      font-weight: 600;\n      color: #17212b;\n      margin: 0 0 12px 0;\n      text-align: left;\n      line-height: 1.28;\n    }\n    .video-desc {\n      font-size: 1.02rem;\n      color: #435160;\n      opacity: .85;\n      margin: 0;\n      text-align: left;\n      line-height: 1.36;\n      min-height: 56px;\n      max-height: 48px;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    /* Lightbox */\n    .lightbox-overlay {\n      position: fixed;\n      top:0; left:0; width:100vw; height:100vh;\n      background: rgba(25,32,45,0.93);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      z-index: 9999;\n      opacity: 0;\n      pointer-events: none;\n      transition: opacity .22s;\n    }\n    .lightbox-overlay.active {\n      opacity: 1;\n      pointer-events: auto;\n    }\n    .lightbox-content {\n      position: relative;\n      background: transparent;\n      max-width: 90vw;\n      max-height: 80vh;\n      border-radius: 7px;\n      box-shadow: 0 0 32px #0004;\n      width: 800px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      overflow: visible;\n    }\n  \n\n    .lightbox-close {\n      position: absolute;\n      top: -38px; right: -4px;\n      font-size: 2.2rem;\n      color: #fff;\n      background: none;\n      border: none;\n      cursor: pointer;\n      font-weight: bold;\n      opacity: 0.86;\n      transition: opacity .16s;\n      z-index: 10;\n    }\n.video-card.loading {\n  opacity: 0;\n  transform: scale(0.97);\n  pointer-events: none;\n}\n\n.video-card.loaded {\n  opacity: 1;\n  transform: scale(1);\n  transition: opacity 0.45s ease, transform 0.45s ease;\n}\n.video-card {\n  background: #fff;\n  border-radius: 7px;\n  box-shadow: 0 6px 28px rgba(44,62,80,0.10), 0 1.5px 5px rgba(44,62,80,0.03);\n  padding: 18px 24px;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  transition: transform 0.25s ease, box-shadow 0.25s ease;\n  will-change: transform, box-shadow;\n  cursor: pointer;\n  position: relative;\n  transform: scale(1); /* za default state */\n}\n.video-card:hover {\n  transform: scale(1.03);\n  box-shadow: 0 12px 40px rgba(44,62,80,0.18), 0 6px 18px rgba(44,62,80,0.06);\n  z-index: 2;\n}\n\n    .lightbox-close:hover { opacity: 1; }\n    @media (max-width:1300px) {\n      .video-grid { max-width: 99vw; }\n    }\n    @media (max-width:1100px) {\n      .video-grid { grid-template-columns: repeat(2, 1fr); }\n   \n      .video-thumb { height: 130px;}\n    }\n    @media (max-width:750px) {\n      .video-grid { grid-template-columns: 1fr; }\n      .video-card { padding: 12px 10px 16px 10px; ; }\n      .video-thumb { height: 100px;}\n    }\n  </style>\n</head>\n<body>\n  <div class=\"video-grid\" id=\"yt-videos\"></div>\n\n  <!-- Lightbox overlay -->\n  <div class=\"lightbox-overlay\" id=\"yt-lightbox\">\n    <div class=\"lightbox-content\">\n      <button class=\"lightbox-close\" title=\"Close\" onclick=\"closeLightbox()\">&times;</button>\n      <div id=\"yt-iframe-wrap\" style=\"width:100%;max-width:820px;min-width:220px;\">\n        <!-- iframe ide ovde -->\n      </div>\n    </div>\n  </div>\n\n  <script>\n  const videoIDs = [\n    \"wC6uOUqmhgs\", \"A5IwZjux114\", \"LYrvXmX6fbo\", \"tHw9ZGK9SXI\",\n    \"YhM2x0sUnyI\", \"2xmpc_bPNOI\", \"ZKxGQbI_wQA\", \"5o-sKAxIsQM\",\n    \"EDen6CMmPXA\", \"dEvE16w_PD0\", \"EXXPjZPUuEM\", \"yM9tC2xdK-M\",\n    \"laCQwi4RH6c\", \"N5bXlb3xF8U\", \"MUyEqYZOD_c\", \"RLNFY-RMipg\",\n    \"qdFP_7W9mLo\", \"LwBlWsK--Po\", \"NVe4cNPD51M\", \"dDsJ3KCMLrY\",\n    \"d48zux0NdRU\", \"wTvhzU1OCNA\", \"m1hYp-ebdxE\", \"BoyHZwaW8Lo\",\n    \"En7KQiRIhvI\"\n  ];\n  const apiKey = \"AIzaSyDUi4QSPs_N87vMiEKPu4uBRT7X4a2t7Lo\";\n\n\n  function openLightbox(id) {\n    const lb = document.getElementById('yt-lightbox');\n    const wrap = document.getElementById('yt-iframe-wrap');\n    wrap.innerHTML = `<iframe loading=\"lazy\" width=\"820\" height=\"460\" style=\"max-width:90vw;max-height:70vh;border-radius:7px;\"\n    src=\"https://www.youtube.com/embed/${id}?autoplay=1&rel=0&showinfo=0\"\n    frameborder=\"0\" allow=\"autoplay; encrypted-media\" allowfullscreen></iframe>`;\n    lb.classList.add('active');\n    document.body.style.overflow = 'hidden';\n  }\n\n  function closeLightbox() {\n    document.getElementById('yt-lightbox').classList.remove('active');\n    document.getElementById('yt-iframe-wrap').innerHTML = '';\n    document.body.style.overflow = '';\n  }\n\n  document.addEventListener('keydown', e => {\n    if (e.key === \"Escape\") closeLightbox();\n  });\n\n  document.getElementById('yt-lightbox').addEventListener('click', function (e) {\n    if (e.target === this) closeLightbox();\n  });\n\n\n  async function fetchVideoData(id) {\n    const resp = await fetch(`https://www.googleapis.com/youtube/v3/videos?part=snippet&id=${id}&key=${apiKey}`);\n    const data = await resp.json();\n    if (data.items && data.items.length > 0) {\n      const vid = data.items[0].snippet;\n      return {\n        id,\n        title: vid.title,\n        desc: vid.description,\n        thumb: vid.thumbnails.medium.url\n      };\n    }\n    return null;\n  }\n\n  (async () => {\n    const ytDiv = document.getElementById(\"yt-videos\");\n    for (let id of videoIDs) {\n      const video = await fetchVideoData(id);\n      if (video) {\n        const card = document.createElement(\"div\");\n        card.className = \"video-card loading\";\n        card.onclick = () => openLightbox(video.id);\n\n        card.innerHTML = `\n          <img decoding=\"async\" src=\"${video.thumb}\" class=\"video-thumb\" alt=\"${video.title}\">\n          <div class=\"video-title\">${video.title}</div>\n          <div class=\"video-desc\">${video.desc.substring(0,110)}...</div>\n        `;\n\n        ytDiv.appendChild(card);\n\n        // Kada se thumbnail učita, dodaj klasu 'loaded'\n        const img = card.querySelector(\"img\");\n        img.onload = () => {\n          card.classList.remove(\"loading\");\n          card.classList.add(\"loaded\");\n        };\n      }\n    }\n  })();\n</script>\n\n</body>\n</html>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t</div>\n\t\t\t\t\t</div>\n\t\t</section>\n\t\t\t\t</div>\n\t\t"
  },
